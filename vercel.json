{
  "version": 2,
  "buildCommand": "npm run build:vercel",

  "framework": null,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/dist/**",
          "dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/docs(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(health|settings|chat|email)(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
